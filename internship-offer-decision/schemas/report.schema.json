{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/internship-offer-decision/report.schema.json",
  "title": "Internship Offer Decision Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "language", "input_level", "subject", "decision", "actual_work", "core_proximity", "takeaways", "support", "risks", "fit", "scores", "decision_uncertainties", "limitations", "evidence"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "language": {"const": "zh-Hant"},
    "input_level": {"enum": ["company_title", "jd", "interview", "full"]},
    "subject": {"$ref": "#/$defs/subject"},
    "decision": {"$ref": "#/$defs/decision"},
    "actual_work": {"$ref": "#/$defs/actualWork"},
    "core_proximity": {"$ref": "#/$defs/coreProximity"},
    "takeaways": {"$ref": "#/$defs/takeaways"},
    "support": {"$ref": "#/$defs/support"},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "fit": {"$ref": "#/$defs/fit"},
    "scores": {"$ref": "#/$defs/scores"},
    "decision_uncertainties": {"type": "array", "items": {"$ref": "#/$defs/decisionUncertainty"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidenceIds": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}, "uniqueItems": true},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["company", "job_title", "location", "duration_months", "work_mode", "student_profile_summary", "alternatives"],
      "properties": {
        "company": {"type": "string", "minLength": 1}, "job_title": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/nullableString"}, "duration_months": {"type": ["number", "null"], "minimum": 0.5, "maximum": 24},
        "work_mode": {"enum": ["onsite", "hybrid", "remote", "unknown"]}, "student_profile_summary": {"$ref": "#/$defs/nullableString"}, "alternatives": {"$ref": "#/$defs/stringList"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "recommendation_score", "confidence", "one_line_conclusion", "base_case", "upside_case", "downside_case", "reasons_for", "reasons_against", "verdict_rationale", "score_method", "score_alignment_note", "evidence_ids"],
      "properties": {
        "verdict": {"enum": ["take", "conditional_take", "decline"]}, "recommendation_score": {"type": "number", "minimum": 0, "maximum": 10},
        "confidence": {"enum": ["low", "medium", "high"]}, "one_line_conclusion": {"type": "string", "minLength": 1},
        "base_case": {"type": "string", "minLength": 1}, "upside_case": {"$ref": "#/$defs/nullableString"}, "downside_case": {"$ref": "#/$defs/nullableString"},
        "reasons_for": {"$ref": "#/$defs/stringList", "minItems": 1, "maxItems": 2}, "reasons_against": {"$ref": "#/$defs/stringList", "minItems": 1, "maxItems": 2},
        "verdict_rationale": {"type": "string", "minLength": 1}, "score_method": {"const": "judgment_not_average"}, "score_alignment_note": {"$ref": "#/$defs/nullableString"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "deliverable", "stakeholder", "success_measure", "confidence", "evidence_ids"],
      "properties": {
        "task": {"type": "string", "minLength": 1}, "deliverable": {"$ref": "#/$defs/nullableString"}, "stakeholder": {"$ref": "#/$defs/nullableString"}, "success_measure": {"$ref": "#/$defs/nullableString"}, "confidence": {"enum": ["low", "medium", "high"]}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "actualWork": {
      "type": "object", "additionalProperties": false, "required": ["summary", "tasks", "non_core_work", "contradictions"],
      "properties": {"summary": {"type": "string", "minLength": 1}, "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}, "non_core_work": {"$ref": "#/$defs/stringList"}, "contradictions": {"$ref": "#/$defs/stringList"}}
    },
    "coreProximity": {
      "type": "object", "additionalProperties": false, "required": ["level", "explanation", "business_flow_touchpoints", "evidence_ids"],
      "properties": {"level": {"enum": ["direct", "adjacent", "support", "unclear"]}, "explanation": {"type": "string", "minLength": 1}, "business_flow_touchpoints": {"$ref": "#/$defs/stringList"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}
    },
    "takeaways": {
      "type": "object", "additionalProperties": false, "required": ["resume_experiences", "skills", "projects", "metrics", "artifacts", "resume_bullets"],
      "properties": {"resume_experiences": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/resumeExperience"}}, "skills": {"$ref": "#/$defs/stringList"}, "projects": {"$ref": "#/$defs/stringList"}, "metrics": {"$ref": "#/$defs/stringList"}, "artifacts": {"$ref": "#/$defs/stringList"}, "resume_bullets": {"$ref": "#/$defs/stringList"}}
    },
    "resumeExperience": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "resume_bullet", "quantification_clues", "learning_to_capture", "base_case_boundary", "confidence", "evidence_ids"],
      "properties": {"title": {"type": "string", "minLength": 1}, "resume_bullet": {"type": "string", "minLength": 1}, "quantification_clues": {"$ref": "#/$defs/stringList"}, "learning_to_capture": {"$ref": "#/$defs/stringList"}, "base_case_boundary": {"type": "string", "minLength": 1}, "confidence": {"enum": ["low", "medium", "high"]}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}
    },
    "lens": {
      "type": "object", "additionalProperties": false, "required": ["assessment", "summary", "evidence_ids"],
      "properties": {"assessment": {"enum": ["positive", "negative", "mixed", "unknown"]}, "summary": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}
    },
    "operatingCondition": {
      "type": "object", "additionalProperties": false, "required": ["status", "explanation", "evidence_ids"],
      "properties": {"status": {"enum": ["strong", "adequate", "weak", "unknown"]}, "explanation": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}
    },
    "support": {
      "type": "object", "additionalProperties": false, "required": ["organizational_coherence", "labor_model", "autonomy_mentorship"],
      "properties": {
        "organizational_coherence": {"$ref": "#/$defs/lens"}, "labor_model": {"$ref": "#/$defs/lens"},
        "autonomy_mentorship": {"type": "object", "additionalProperties": false, "required": ["ownership", "feedback", "mentorship", "methodology"], "properties": {"ownership": {"$ref": "#/$defs/operatingCondition"}, "feedback": {"$ref": "#/$defs/operatingCondition"}, "mentorship": {"$ref": "#/$defs/operatingCondition"}, "methodology": {"$ref": "#/$defs/operatingCondition"}}}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "description", "severity", "likelihood", "student_impact", "mitigation", "evidence_ids"],
      "properties": {"id": {"type": "string", "pattern": "^R[0-9]{3,}$"}, "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "severity": {"enum": ["low", "medium", "high"]}, "likelihood": {"enum": ["low", "medium", "high", "unknown"]}, "student_impact": {"type": "string", "minLength": 1}, "mitigation": {"$ref": "#/$defs/nullableString"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}
    },
    "fit": {
      "type": "object", "additionalProperties": false, "required": ["suitable_for", "unsuitable_for"],
      "properties": {"suitable_for": {"$ref": "#/$defs/stringList"}, "unsuitable_for": {"$ref": "#/$defs/stringList"}}
    },
    "score": {
      "type": "object", "additionalProperties": false, "required": ["score", "rationale", "confidence", "evidence_ids"],
      "properties": {"score": {"type": "number", "minimum": 0, "maximum": 10}, "rationale": {"type": "string", "minLength": 1}, "confidence": {"enum": ["low", "medium", "high"]}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}
    },
    "scores": {
      "type": "object", "additionalProperties": false, "required": ["role_substance", "learning_gain", "resume_outcome_potential", "team_company_leverage", "overall_roi"],
      "properties": {"role_substance": {"$ref": "#/$defs/score"}, "learning_gain": {"$ref": "#/$defs/score"}, "resume_outcome_potential": {"$ref": "#/$defs/score"}, "team_company_leverage": {"$ref": "#/$defs/score"}, "overall_roi": {"$ref": "#/$defs/score"}}
    },
    "decisionUncertainty": {
      "type": "object", "additionalProperties": false, "required": ["title", "missing_evidence", "score_effect", "base_case_assumption", "evidence_ids"],
      "properties": {"title": {"type": "string", "minLength": 1}, "missing_evidence": {"type": "string", "minLength": 1}, "score_effect": {"type": "string", "minLength": 1}, "base_case_assumption": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tier", "direction", "source_type", "title", "url", "observed_at", "claim", "relevance", "anonymous"],
      "properties": {"id": {"type": "string", "pattern": "^E[0-9]{3,}$"}, "tier": {"enum": ["strong", "signal", "weak"]}, "direction": {"enum": ["positive", "negative", "unknown"]}, "source_type": {"enum": ["jd", "interview", "offer", "official", "product", "partner", "public_project", "hiring_history", "founder_statement", "team_structure", "social", "github", "tenure", "anonymous_review", "other"]}, "title": {"type": "string", "minLength": 1}, "url": {"type": ["string", "null"], "format": "uri"}, "observed_at": {"type": ["string", "null"], "format": "date"}, "claim": {"type": "string", "minLength": 1}, "relevance": {"type": "string", "minLength": 1}, "anonymous": {"type": "boolean"}}
    }
  }
}
