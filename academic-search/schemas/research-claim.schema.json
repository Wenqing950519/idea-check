{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/academic-search/research-claim.schema.json",
  "title": "Research Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "text", "status", "evidence_ids", "counterevidence_ids", "hypothesis_id", "rationale", "human_review_required", "created_at"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "status": {"enum": ["SUPPORTED", "PARTIAL", "CONTRADICTED", "UNRESOLVED"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "counterevidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "hypothesis_id": {"type": ["string", "null"]},
    "rationale": {"type": "string"},
    "human_review_required": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
