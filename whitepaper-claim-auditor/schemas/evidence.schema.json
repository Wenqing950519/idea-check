{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/whitepaper-claim-auditor/evidence.schema.json",
  "title": "Passage-Level Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id", "claim_id", "source_title", "source_author", "source_type",
    "publisher_or_org", "year", "url_or_doi", "document_locator", "passage",
    "relation", "source_quality", "retrieval_query", "notes"
  ],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^E-[0-9]{3,}$"},
    "claim_id": {"type": "string", "pattern": "^C-[0-9]{3}(?:-[A-Z0-9]+)*$"},
    "source_title": {"type": "string", "minLength": 1},
    "source_author": {"type": "string"},
    "source_type": {
      "enum": ["peer_reviewed_paper", "conference_paper", "systematic_review", "official_documentation", "government_statistics", "standard", "first_party_dataset", "industry_research", "professional_media", "blog", "forum", "local_document", "other"]
    },
    "publisher_or_org": {"type": "string"},
    "year": {"type": ["integer", "null"], "minimum": 1800, "maximum": 2200},
    "url_or_doi": {"type": "string", "minLength": 1},
    "document_locator": {"type": "string", "minLength": 1},
    "passage": {"type": "string", "minLength": 1},
    "relation": {"enum": ["DIRECT_SUPPORT", "PARTIAL_SUPPORT", "CONTEXT_ONLY", "QUALIFIES", "CONTRADICTS", "IRRELEVANT", "UNRESOLVED"]},
    "source_quality": {"enum": ["A", "B", "C", "D", "E"]},
    "retrieval_query": {"type": "string"},
    "notes": {"type": "string"},
    "causal_design": {"type": "boolean", "default": false},
    "scope_match": {"type": "boolean", "default": false},
    "boundary_condition": {"type": "boolean", "default": false},
    "citation_key": {"type": ["string", "null"]},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
